        "jsCode": "const { DateTime } = require('luxon');\n\n// Configuração\nconst FUSO_HORARIO = 'America/Sao_Paulo';\nconst DIAS = ['domingo','segunda','terça','quarta','quinta','sexta','sabado'];\n\n// Pega dados\nconst janelas = $('Gerar janelas de tempo').all();\nif (!janelas.length) return [];\n\nconst { id_agenda } = $('Gatilho').first().json;\nconst disponibilidade_full = $('Disponibilidade').first().json;\nconst disponibilidade_dia_array = disponibilidade_full[id_agenda];\n\nif (!disponibilidade_dia_array) throw new Error(\"Disponibilidade não encontrada.\");\n\n// Função auxiliar para converter \"HH:mm\" em minutos\nfunction horaTextoParaMinutos(texto) {\n  const [h, m] = texto.split(':').map(Number);\n  return h * 60 + m;\n}\n\n// Filtro\nconst janelasFiltradas = janelas.filter(item => {\n  const janela = item.json;\n  \n  // 1. Converte datas forçando o fuso horário correto\n  const inicioDT = DateTime.fromISO(janela.inicio_janela).setZone(FUSO_HORARIO);\n  const fimDT = DateTime.fromISO(janela.fim_janela).setZone(FUSO_HORARIO);\n  \n  // 2. Verifica dia da semana\n  // Luxon: 1=Seg .. 7=Dom. O array DIAS espera 0=Dom..6=Sab\n  let diaIndex = inicioDT.weekday === 7 ? 0 : inicioDT.weekday;\n  const nomeDia = DIAS[diaIndex];\n  \n  const regrasDoDia = availability_rules = disponibilidade_dia_array[nomeDia];\n  \n  if (!regrasDoDia) return false;\n\n  // 3. Converte janela atual para minutos do dia (ex: 10:00 = 600)\n  const inicioJanelaMin = inicioDT.hour * 60 + inicioDT.minute;\n  const fimJanelaMin = fimDT.hour * 60 + fimDT.minute;\n\n  // 4. Verifica se cabe em algum bloco livre\n  const cabe = regrasDoDia.some(regra => {\n    const inicioRegra = horaTextoParaMinutos(regra.inicio);\n    const fimRegra = horaTextoParaMinutos(regra.fim);\n\n    // LÓGICA DE OURO:\n    // O Início da janela deve ser >= Início da Regra\n    // O Fim da janela deve ser <= Fim da Regra\n    const resultado = (inicioJanelaMin >= inicioRegra && fimJanelaMin <= fimRegra);\n    \n    return resultado;\n  });\n\n  return cabe;\n});\n\nreturn janelasFiltradas;"
      },
